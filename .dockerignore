finetune/data/val.jsonl
unsloth_compiled_cache
deliverables/report/*.aux
deliverables/report/*.log
deliverables/report/*.pdf
deliverables/report/*.bbl
deliverables/report/*.blg
deliverables/report/*.fdb_latexmk
deliverables/report/*.fls
deliverables/report/*.out
deliverables/report/*.synctex.gz
