# pixi environments
.pixi/*
!.pixi/config.toml

# Python
__pycache__/
*.py[cod]

# Secrets
.env

# Per-user settings (created on first run from stl_agent/data/settings.defaults.toml)
settings.toml
settings.toml.tmp
# The Docker container's settings folder (README "Docker")
/data/

# Local notes (e.g. pasted API docs)
info/

# Generated output
outputs/
*.stl

# Renders of downloaded Thingiverse models (#42 comparison): third-party models, many licensed NC/ND, so not
# committed. Recreated locally by `judge run` from outputs/bench/. Any depth: studies nest one level deeper.
eval/renders/**/thingiverse/

# Fine-tuning (#46): checkpoints, adapters and GGUF files are large; train/val are rebuilt by `ft-export`
finetune/runs/
finetune/data/train.jsonl
finetune/data/val.jsonl
unsloth_compiled_cache/

# UCF brand PowerPoint template: a UCF asset, downloaded locally (deliverables/presentation/README.md)
deliverables/presentation/*.potx

# LibreOffice lock files (a document open in LibreOffice)
.~lock.*#
